# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Build / install artifacts ----
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# ---- Editable installs / venvs ----
.venv/
venv/
env/
.python-version

# ---- Test / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
