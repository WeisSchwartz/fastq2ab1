Thumbs.db

# ---- Project-specific ----
# Real sequencing data — kept locally, never committed.
test data/
*.bam
*.bam.bai
*.fastq
*.fastq.gz
*.ab1

# Allow checked-in synthetic test fixtures if we ever add them
!tests/fixtures/**/*.bam
!tests/fixtures/**/*.fastq
!tests/fixtures/**/*.ab1
